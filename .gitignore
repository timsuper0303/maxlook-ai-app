# ═══════════════════════════════════════════════════════
# Maxlook AI App — .gitignore
# ═══════════════════════════════════════════════════════

# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnp/
.pnp.js

# Environment & secrets — NEVER commit
.env
.env.local
.env.development
.env.production
.env.*.local
*.env

# User uploads — privacy
uploads/
public/uploads/

# Test outputs (large generated images)
test-output/
coverage/
.nyc_output/

# Data
data/
*.sqlite
*.db
*.db-journal
local.db

# Logs
logs/
*.log
pm2.log

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Editor
.vscode/
.idea/
*.swp
*.swo
*~

# Build artifacts
dist/
build/
.cache/

# Sessions / temporary
sessions/
tmp/
temp/

# Hostinger artifacts
.htaccess.bak

# Lock files alternatives — keep package-lock.json only
yarn.lock
pnpm-lock.yaml

# Sensitive backups
*.backup
*.bak
