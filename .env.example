# ═══════════════════════════════════════════════════════
# Maxlook AI App — Environment Variables Template
# Copy this file to .env and fill in real values
# ═══════════════════════════════════════════════════════

# === AI ENGINE — pilih salah satu setup ===

# [OPTION A — RECOMMENDED] OpenAI Direct (paling reliable)
# Daftar di https://platform.openai.com, top-up $5 (cukup ~1500 scan)
KIE_API_KEY=sk-proj-paste-OpenAI-key-lo-di-sini
KIE_API_BASE_URL=https://api.openai.com/v1
AI_VISION_MODEL=gpt-4o-mini

# [OPTION B — alternatif] OpenAI gpt-4o (lebih akurat, lebih mahal ~3x)
# AI_VISION_MODEL=gpt-4o

# [OPTION C — alternatif] KIE.ai (tidak reliable saat ini)
# KIE_API_KEY=e48416f9b3cb1bf28c7dfdee1d9af723
# KIE_API_BASE_URL=https://api.kie.ai/v1
# AI_VISION_MODEL=claude-3-5-sonnet-20241022

# === SERVER ===
PORT=3000
NODE_ENV=development

# === RATE LIMITING ===
# Berapa scan/minggu per customer (sesuai promise di LP)
SCAN_LIMIT_PER_WEEK=1

# === TELEGRAM BOT (skip dulu) ===
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_ENABLED=false
